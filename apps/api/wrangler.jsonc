{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "entregas",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Painel (React) servido pelo mesmo Worker: /api/* vai para o código, o resto para os arquivos estáticos.
  "assets": {
    "directory": "../painel/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entregas",
      // Trocar pelo ID real ao criar o banco na Cloudflare (wrangler d1 create entregas).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Fotos de comprovante de entrega (wrangler r2 bucket create entregas-fotos).
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "entregas-fotos" }],

  // Todo dia às 03:00 de Cascavel (06:00 UTC): apaga pontos de GPS antigos (LGPD).
  "triggers": { "crons": ["0 6 * * *"] },

  "vars": {
    "AMBIENTE": "desenvolvimento",
    // Origens que podem chamar a API pelo navegador com Bearer (só o app rodando na web em desenvolvimento).
    // Vazio em produção: o app Android não usa CORS.
    "ORIGENS_APP": ""
  }
  // Segredos (wrangler secret put): SETUP_TOKEN — usado uma única vez para criar o primeiro super admin.
}
