{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "entregas",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Painel (React) servido pelo mesmo Worker: /api/* vai para o código, o resto para os arquivos estáticos.
  // /r/* (rastreio público) passa pelo código para servir a página leve de acompanhamento.
  "assets": {
    "directory": "../painel/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"]
  },

  // Tempo real: um CentralEmpresa por empresa (mapa ao vivo e rastreio por WebSocket).
  "durable_objects": {
    "bindings": [{ "name": "CENTRAL", "class_name": "CentralEmpresa" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CentralEmpresa"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entregas",
      // Só local: o banco da Cloudflare fica em env.producao. Trocar este ID apagaria (de vista) o banco local.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Fotos de comprovante de entrega (wrangler r2 bucket create entregas-fotos).
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "entregas-fotos" }],

  // Todo dia às 03:00 de Cascavel (06:00 UTC): apaga pontos de GPS antigos (LGPD).
  "triggers": { "crons": ["0 6 * * *"] },

  "vars": {
    "AMBIENTE": "desenvolvimento",
    // Origens que podem chamar a API pelo navegador com Bearer (só o app rodando na web em desenvolvimento).
    // Vazio em produção: o app Android não usa CORS.
    "ORIGENS_APP": ""
  },
  // Segredos (wrangler secret put --env producao): SETUP_TOKEN — usado uma única vez para criar o primeiro super admin.

  // O que está acima é o desenvolvimento local (wrangler dev, testes). O que vai para a Cloudflare
  // é este ambiente: npm run deploy -w @entregas/api. Assets, cron, observabilidade e as migrations
  // do Durable Object são herdados; bindings e vars precisam ser repetidos.
  "env": {
    "producao": {
      "name": "entregas",
      "durable_objects": {
        "bindings": [{ "name": "CENTRAL", "class_name": "CentralEmpresa" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "entregas",
          "database_id": "ca0b37f4-5e5d-429f-b04a-6307ecc1c02e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "entregas-fotos" }],
      "vars": {
        "AMBIENTE": "producao",
        "ORIGENS_APP": ""
      }
    }
  }
}
